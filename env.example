# Copy this file to .env and add your real Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Current defaults used by the project. Change only if your API account exposes another model.
GEMINI_WORKOUT_MODEL=gemini-3.7-flash
GEMINI_TIP_MODEL=gemini-3.7-flash

# Optional. Default creates fitbuddy.db in the project root.
DATABASE_URL=sqlite:///./fitbuddy.db
